      "item": [
        {
          "id": "89100700-a9cc-4292-9ac0-bd02f855d49e",
          "name": "Download API Specification",
          "request": {
            "name": "Download API Specification",
            "description": {
              "content": "Downloads the OpenAPI or WSDL specification generated from discovered API traffic for the authenticated environment. The specification reflects the actual observed API surface including endpoints, parameters, and request/response schemas. Use the createApiDefinition GraphQL mutation to trigger generation first, then retrieve the download URL via getApiDefinition query.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rest",
                "download"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "format",
                  "value": "openapi-yaml",
                  "description": "Specification format to download."
                },
                {
                  "disabled": false,
                  "key": "service",
                  "value": "<string>",
                  "description": "Filter specification to a specific service name."
                },
                {
                  "disabled": false,
                  "key": "domain",
                  "value": "<string>",
                  "description": "Filter specification to a specific domain."
                },
                {
                  "disabled": false,
                  "key": "label",
                  "value": "<string>",
                  "description": "Filter specification by API label."
                },
                {
                  "disabled": false,
                  "key": "environment",
                  "value": "<string>",
                  "description": "Filter specification by deployment environment."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/x-yaml"
              }
            ],
            "method": "GET",
            "auth": null
          },
